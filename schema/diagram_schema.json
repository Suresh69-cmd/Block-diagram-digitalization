{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Control System Block Diagram",
  "type": "object",
  "required": ["metadata", "blocks", "text", "connections", "diagram"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["schema_version", "source_image", "created_at"],
      "properties": {
        "schema_version": { "type": "string" },
        "source_image": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    },
    "text": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    },
    "diagram": {
      "type": "object",
      "required": ["type", "block_count", "text_count", "connection_count"],
      "properties": {
        "type": { "type": "string" },
        "block_count": { "type": "integer", "minimum": 0 },
        "text_count": { "type": "integer", "minimum": 0 },
        "connection_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "type", "label", "bbox", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "text_item": {
      "type": "object",
      "required": ["id", "text", "bbox", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "connection": {
      "type": "object",
      "required": ["id", "from", "to", "points", "arrow", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/point" }
        },
        "arrow": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}

